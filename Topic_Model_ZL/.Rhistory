# plot topic proportions per period as bar plot
ggplot(vizDataFrame, aes(x=period_label, y=value, fill=category)) +
geom_bar(stat = "identity") + ylab("proportion") + xlab("period") +
theme(axis.text.x = element_text(angle = 90, hjust = 1)) +
